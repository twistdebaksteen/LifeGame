# Kopieer naar .env en vul in. Zet .env NOOIT in git of in een chat.
# Maak de sleutel aan op OKX met ALLEEN de rechten "Read" en "Trade" (NOOIT "Withdraw"),
# en koppel hem indien mogelijk aan het IP-adres van de computer waarop de bot draait.

# Echt account (live)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# OKX demo trading-account (live --demo), aparte sleutels
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=
